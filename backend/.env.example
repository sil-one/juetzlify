# Jützlify Backend Configuration
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=production
PORT=3000

# Paths (use these defaults for Docker deployment)
TRACKS_PATH=/app/backend/tracks
CACHE_PATH=/app/backend/cache/album-art
DATA_PATH=/app/backend/data

# Authentication
# IMPORTANT: Generate secure password hashes before deploying!
#
# On Mac/Linux, generate hashes with:
#   echo -n "your-password" | shasum -a 256
#
# Replace the values below with your generated hashes:
PRIVATE_PASSWORD_HASH=your-private-password-hash-here
ADMIN_PASSWORD_HASH=your-admin-password-hash-here

# Example hashes (for development only - DO NOT USE IN PRODUCTION):
# Password "private" = 04f8996da763b7a969b1028ee3007569eaf3a635486ddab211d512c85b9df8fb
# Password "admin"   = 8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
